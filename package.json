{
  "name": "facturas-inbox-mcp",
  "version": "0.1.0",
  "description": "MCP server that turns a folder of Spanish invoice PDFs into validated, structured data: classify documents, extract NIF/IVA/IRPF/totals with arithmetic checks, and summarize IVA soportado/repercutido per period. Local, read-only, no API keys.",
  "mcpName": "io.github.pedrozapatadev/facturas-inbox-mcp",
  "type": "module",
  "bin": {
    "facturas-inbox-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "examples/inbox",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js examples/inbox",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "invoices",
    "facturas",
    "spain",
    "iva",
    "irpf",
    "nif",
    "gestoria",
    "document-intake"
  ],
  "author": "Pedro Zapata Medal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrozapatadev/facturas-inbox-mcp.git"
  },
  "homepage": "https://github.com/pedrozapatadev/facturas-inbox-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.19.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
